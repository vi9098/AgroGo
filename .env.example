# ==============================================================================
# AgriGo Production Environment Configuration (.env)
# ==============================================================================

# Application Environment
APP_NAME="AgriGo Secure Agriculture AI"
APP_ENV=production
PORT=8000
HOST=0.0.0.0
DEBUG=false

# Server-Side Session Security
SESSION_COOKIE_NAME=agrigo_session
SESSION_SECRET_KEY=generate-a-secure-random-64-character-hex-string-for-production
SESSION_ABSOLUTE_EXPIRY_DAYS=7
SESSION_IDLE_TIMEOUT_HOURS=2
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Database Configuration (SQLite default with persistent schema and transactions)
DATABASE_URL=sqlite:///./backend/agrigo.db
# Optional Google Drive Database Sync (paste your public/shareable Drive link or File ID):
# Example URL: https://drive.google.com/file/d/1A2B3C4D5E6F/view?usp=sharing
GOOGLE_DRIVE_DB_URL=
GOOGLE_DRIVE_DB_FILE_ID=
FORCE_DRIVE_DB_SYNC=false

# Optional MongoDB / Redis for high-throughput scaling
MONGODB_URI=mongodb://localhost:27017/agrigo
REDIS_URL=redis://localhost:6379

# CORS Restrictions
CORS_ORIGINS=["https://agrigo.yourdomain.com", "http://127.0.0.1:8000", "http://localhost:8000"]

# Media & Document Storage
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# Weather & Agromet API (Open-Meteo is free & backend-only)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Government Mandi Prices Pipeline (data.gov.in Agmarknet)
DATA_GOV_IN_API_KEY=579b464db66ec23bdd000001cdc3b564546246a772a26393094f5645
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# AI & LLM Providers (Kept on backend only, never exposed to client)
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Speech-to-Text & Text-to-Speech Providers
GOOGLE_STT_KEY=your-google-speech-to-text-key
GOOGLE_TTS_KEY=your-google-text-to-speech-key

# Admin 2FA & Telemetry
ADMIN_2FA_ISSUER="AgriGo Intelligence Command"

# Authkey.io Dynamic SMS OTP Service (api.authkey.io & console.authkey.io)
# Request URL: https://api.authkey.io/request?authkey=AUTHKEY&mobile=RecepientMobile&country_code=CountryCodeWithoutPlusSign&sms=Hello, your OTP is 1234&sender=SENDERID&pe_id=ENTITY_ID&template_id=DLT_TEMPLATE_ID
# Verify URL:  https://console.authkey.io/api/2fa_verify.php?authkey=AUTHKEY&channel=SMS&otp=OTP&logid=LogID
AUTHKEY_API_KEY=your_authkey_api_key_here
AUTHKEY_SENDER=AGRIGO
AUTHKEY_PE_ID=your_dlt_principal_entity_id
AUTHKEY_TEMPLATE_ID=your_dlt_template_id
AUTHKEY_SMS_TEMPLATE="Hello, your OTP is {otp}"
AUTHKEY_SID=your_authkey_template_sid_here
AUTHKEY_HOST=api.authkey.io
AUTHKEY_VERIFY_HOST=console.authkey.io
